{
  "expo": {
    "name": "Shiggy Trails",
    "slug": "hcp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hcp",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1E8",
          "dark": {
            "backgroundColor": "#171717",
            "image": "./assets/images/splash-icon-dark.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F4511E",
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shiggy Trails reads the photos and videos you choose to post, in a post, a reel, a flyer or your profile.",
          "cameraPermission": "Shiggy Trails uses the camera to record a reel.",
          "microphonePermission": "Shiggy Trails records sound with the video in a reel."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shiggy Trails uses your location to drop a pin where your kennel hashes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
