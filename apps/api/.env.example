NODE_ENV=development
PORT=5010

# Local Postgres (pgAdmin4-managed install, not Docker)
DATABASE_URL="postgresql://postgres:your-postgres-password@localhost:5432/hcp_db"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# FR-ID-005: encrypts PersonProfile's most sensitive columns (date of birth,
# phone, emergency contacts, medical notes) at the application layer.
# 32 bytes, hex-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PERSON_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Web on 3010, admin on 3011
CORS_ORIGINS=http://localhost:3010,http://localhost:3011,http://localhost:8081,http://localhost:8082

# Loose outside production so a QA pass doesn't rate-limit itself
AUTH_RATE_LIMIT=1000
LOG_LEVEL=debug

SEED_ADMIN_EMAIL=admin@hcp.test
SEED_ADMIN_PASSWORD=OnOn2026!
SEED_USER_EMAIL=hasher@hcp.test
SEED_USER_PASSWORD=OnOn2026!

# ─── Where the apps live (used in email links and the dev media fallback) ───
APP_BASE_URL=https://shiggytrails.com
API_BASE_URL=http://localhost:5010

# ─── Cloudflare R2: photos and media (D28) ───
# All four are required together. Without them, uploads fall back to local disk
# in apps/api/uploads/ and are served from /uploads/*, which is development only.
# Setup, including the CORS policy the browser upload needs: CODEX/PROVIDERS.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hcp-media
# The public domain in front of the bucket. Without it, media is stored but has
# no URL to display. Typical custom-domain setup is a media subdomain like
# https://media.shiggytrails.com.
R2_PUBLIC_BASE_URL=https://media.shiggytrails.com

# Largest accepted upload, in bytes (default 25MB)
MEDIA_MAX_BYTES=26214400
# Largest video on a post, in bytes (default 100MB). Reels and photos keep the cap above.
MEDIA_MAX_POST_VIDEO_BYTES=104857600
# Video is re-encoded to H.264 MP4 after upload (D67). On by default, using the ffmpeg that
# ffmpeg-static installs; FFMPEG_PATH points at a system ffmpeg instead, and
# TRANSCODE_ENABLED=false turns it off (clips are then served as uploaded).
# TRANSCODE_TIMEOUT_MS is how long one clip may take (default 300000).
TRANSCODE_ENABLED=true
FFMPEG_PATH=
TRANSCODE_TIMEOUT_MS=300000

# ─── Resend: email (D28) ───
# Without a key, notifications stay in-app and say so. Once your domain is
# verified in Resend, switch to a real sender address on that domain.
RESEND_API_KEY=
EMAIL_FROM=Shiggy Trails <onboarding@shiggytrails.com>
EMAIL_REPLY_TO=

# ─── Cache invalidation for the public web pages ───
# The web app caches public pages for 60s (Next ISR). That refreshes a page
# whose data changed, but NOT one whose data disappeared: an archived or hidden
# kennel keeps serving its last good render at its old URL. Setting this shared
# secret (the same value in apps/web/.env.local) lets the API evict those pages
# the moment a kennel is archived. Without it, nothing breaks — archived pages
# just linger.
REVALIDATE_SECRET=
WEB_REVALIDATE_URL=http://localhost:3010/api/revalidate

# ─── Claude: AI-assisted trail report drafting (D7/D14, FR-STORY-007) ───
# Without a key, the Scribe's "Ask Claude to draft this" button answers
# AI_NOT_CONFIGURED and the report is written unaided — nothing else changes.
ANTHROPIC_API_KEY=

# ─── Push notifications through Expo (D12) ───
# No key is required: Expo accepts a send addressed to a valid push token, so
# push works as soon as a hasher registers a device from the mobile app. Set
# PUSH_ENABLED=false to switch the channel off platform-wide (every notification
# then records that push was disabled, and nothing is queued for it).
PUSH_ENABLED=true
# Only needed if you turn on "enhanced security" for the Expo project, which
# makes unsigned sends fail. https://docs.expo.dev/push-notifications/sending-notifications/
EXPO_ACCESS_TOKEN=
