// Shiggy Trails
//
// Source of truth: product-Bible Chapter 23 (entities + relationships) and
// Chapter 22 (every `status` enum below is a Chapter 22 state machine, named
// verbatim where the chapter names it). Stakeholder decisions D1-D17 live in
// CODEX/DECISION-LOG.md and are referenced inline where they shape a field.
//
// Conventions
// - Every id is a UUID and never changes (Ch.23 naming conventions).
// - Historical records (timelines, revisions, appointments, audit, events) are
//   append-only. Corrections are new rows, never destructive updates.
// - Actor attribution columns that exist purely for audit (approvedById,
//   publishedById, ...) are plain UUID columns rather than relations: they are
//   read by audit tooling, not traversed by the app, and a relation per actor
//   column would add dozens of back-references to User.
// - No direct / one-to-one messaging model exists. That is deliberate (D8).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

